---
import { log } from '../data/site';
---

<section id="path" aria-labelledby="path-title">
	<h2 id="path-title">From Milano to Luxembourg</h2>
	<p class="cmd mono" aria-hidden="true"><span class="typed">git log --graph --oneline</span></p>
	<ol class="log">
		{
			log.map((commit, i) => {
				const head = i === 0;
				const root = i === log.length - 1;
				const forks = !commit.side && log[i + 1]?.side;
				const merges = !commit.side && log[i - 1]?.side;
				return (
					<li class:list={['commit', { side: commit.side }]} style={`--k: ${log.length - 1 - i}`}>
						<div class="graph" aria-hidden="true">
							<span class:list={['lane', 'a', { 'from-dot': head, 'to-dot': root }]} />
							{commit.side && <span class="lane b" />}
							{forks && (
								<>
									<svg class="fork" viewBox="0 0 22 22">
										<path d="M0 0C0 13 22 9 22 22" pathLength="1" />
									</svg>
									<span class="lane b after-fork" />
								</>
							)}
							{merges && (
								<>
									<span class="lane b before-merge" />
									<svg class="merge" viewBox="0 0 22 22">
										<path d="M22 0C22 13 0 9 0 22" pathLength="1" />
									</svg>
								</>
							)}
							<span class:list={['dot', commit.side ? 'b' : 'a', { head }]} />
						</div>
						<div class="body">
							<p class="msg">
								<code class="hash mono" aria-hidden="true">{commit.hash}</code>
								<span class="role">{commit.role}</span>
								{head && (
									<>
										<span class="ref mono" aria-hidden="true">HEAD -&gt; luxembourg</span>
										<span class="sr-only">, current position</span>
									</>
								)}
								{commit.side && <span class="sr-only">, in parallel with the role below</span>}
							</p>
							<p class="place">
								{commit.place} · <span class="when">{commit.when}</span>
							</p>
						</div>
					</li>
				);
			})
		}
	</ol>
	<script is:inline>
		(() => {
			const section = document.getElementById('path');
			if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
			section.classList.add('armed');
			new IntersectionObserver(
				(entries, observer) => {
					if (!entries.some((entry) => entry.isIntersecting)) return;
					section.classList.add('play');
					observer.disconnect();
				},
				{ threshold: 0.3 },
			).observe(section);
		})();
	</script>
</section>

<style>
	section {
		margin-top: 28px;
	}

	h2 {
		margin-bottom: 0;
	}

	.mono {
		font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
	}

	.cmd {
		font-size: 14px;
		color: var(--slate);
		margin: 6px 0 14px;
	}

	.cmd::before {
		content: '$ ';
		color: var(--line);
	}

	.log {
		max-width: 46em;
	}

	.commit {
		position: relative;
		display: grid;
		grid-template-columns: 48px minmax(0, 1fr);
	}

	.body {
		padding: 10px 0;
	}

	.side .body {
		padding-left: 22px;
	}

	/* Lanes at x = 12.5 and 34.5; dots sit at --cy, the middle of the 26px role line. */
	.graph {
		position: relative;
		--cy: 23px;
	}

	.graph > * {
		position: absolute;
	}

	.lane {
		width: 3px;
		background: var(--line);
		top: 0;
		bottom: 0;
	}

	.lane.a {
		left: 11px;
	}

	.lane.b {
		left: 33px;
	}

	.from-dot {
		top: var(--cy);
	}

	.to-dot {
		bottom: auto;
		height: var(--cy);
	}

	.after-fork {
		top: calc(var(--cy) + 22px);
	}

	.before-merge {
		bottom: auto;
		height: calc(var(--cy) - 22px);
	}

	svg {
		left: 12.5px;
		width: 22px;
		height: 22px;
		overflow: visible;
	}

	path {
		fill: none;
		stroke: var(--line);
		stroke-width: 3;
	}

	.fork {
		top: var(--cy);
	}

	.merge {
		top: calc(var(--cy) - 22px);
	}

	.dot {
		width: 13px;
		height: 13px;
		top: calc(var(--cy) - 6.5px);
		margin-left: -6.5px;
		border: 3px solid var(--line);
		border-radius: 999px;
		background: var(--paper);
		z-index: 1;
	}

	.dot.a {
		left: 12.5px;
	}

	.dot.b {
		left: 34.5px;
	}

	.dot.head {
		width: 17px;
		height: 17px;
		top: calc(var(--cy) - 8.5px);
		margin-left: -8.5px;
		background: var(--line);
	}

	.msg {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0 10px;
		line-height: 26px;
	}

	.hash {
		font-size: 14px;
		color: var(--slate);
	}

	.role {
		font-family: var(--sans);
		font-weight: 600;
		font-size: 17px;
	}

	.ref {
		font-size: 12.5px;
		line-height: 1;
		padding: 3px 7px;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--line);
		color: var(--paper);
		white-space: nowrap;
	}

	.place {
		font-size: 15px;
		line-height: 1.5;
		color: var(--slate);
	}

	.when {
		font-family: var(--sans);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	@media (max-width: 760px) {
		.hash {
			display: none;
		}
	}

	/*
	 * Motion, only once the script arms the section: the command types out, then history
	 * builds from the root commit up, one commit every 0.22s (--k counts from the bottom).
	 */
	.armed:not(.play) *,
	.armed:not(.play) *::before,
	.armed:not(.play) *::after {
		animation-play-state: paused;
	}

	.armed .typed {
		display: inline-block;
		overflow: hidden;
		white-space: nowrap;
		vertical-align: bottom;
		animation: type 0.9s steps(25) both;
	}

	.armed .cmd::after {
		content: '';
		display: inline-block;
		width: 0.6em;
		height: 1.1em;
		margin-left: 2px;
		vertical-align: text-bottom;
		background: var(--slate);
		animation: blink 0.5s steps(1) 6 both;
	}

	.armed .commit {
		--d: calc(1s + var(--k) * 0.22s);
	}

	.armed .lane {
		transform-origin: bottom;
		animation: rise 0.25s var(--d) linear both;
	}

	.armed path {
		stroke-dasharray: 1;
		animation: draw 0.25s calc(var(--d) + 0.1s) ease-out both;
	}

	.armed .dot {
		animation: pop 0.3s calc(var(--d) + 0.15s) ease-out both;
	}

	.armed .body {
		animation: enter 0.4s calc(var(--d) + 0.15s) ease-out both;
	}

	.armed .ref {
		display: inline-block;
		animation: pop 0.35s calc(var(--d) + 0.45s) ease-out both;
	}

	@keyframes type {
		from {
			width: 0;
		}
		to {
			width: 25ch;
		}
	}

	@keyframes blink {
		0% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	@keyframes rise {
		from {
			transform: scaleY(0);
		}
	}

	/* Paths run top to bottom, so a negative offset draws them upward from their end. */
	@keyframes draw {
		from {
			stroke-dashoffset: -1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes pop {
		from {
			opacity: 0;
			transform: scale(0.3);
		}
	}

	@keyframes enter {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
	}

	@media (forced-colors: active) {
		.lane {
			background: CanvasText;
		}

		path {
			stroke: CanvasText;
		}

		.dot {
			border-color: CanvasText;
		}

		.dot.head {
			background: CanvasText;
		}
	}
</style>
