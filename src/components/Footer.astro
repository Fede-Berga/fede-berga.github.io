---
import { links } from '../data/site';
---

<footer class="wrap">
	<div class="bar" aria-hidden="true"></div>
	<span>Federico Bergamini, Luxembourg</span>
	<ul>
		{
			links.map((link) => (
				<li>
					<a href={link.href}>{link.label}</a>
				</li>
			))
		}
	</ul>
</footer>

<style>
	footer {
		margin-top: 96px;
		padding-bottom: 40px;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 8px 24px;
		font-family: var(--sans);
		font-size: 15px;
		color: var(--slate);
	}

	.bar {
		flex-basis: 100%;
		height: 1px;
		background: var(--rule);
		margin-bottom: 12px;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 20px;
	}
</style>
