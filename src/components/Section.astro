---
import Label from './Label.astro';

interface Props {
	n: string;
	id: string;
	title: string;
	class?: string;
}

const { n, id, title, class: className } = Astro.props;
---

<section
	class:list={['grid gap-x-10 border-t border-rule pt-7 pb-16 md:grid-cols-[3fr_9fr] md:pb-22', className]}
	aria-labelledby={id}
>
	<Label n={n} id={id}>{title}</Label>
	<slot />
</section>
