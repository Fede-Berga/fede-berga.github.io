---
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Projects from '../components/Projects.astro';
import Publications from '../components/Publications.astro';
import Route from '../components/Route.astro';
import Teaching from '../components/Teaching.astro';
import Base from '../layouts/Base.astro';
---

<Base
	title="Federico Bergamini"
	description="Federico Bergamini, PhD student at the University of Luxembourg working on automated penetration testing with large language models."
>
	<Header />
	<main id="main" class="wrap">
		<div class="hero">
			<About />
			<Publications />
		</div>
		<Route />
		<Projects />
		<Teaching />
	</main>
	<Footer />
</Base>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
		gap: 64px;
		padding-top: 12px;
	}

	@media (max-width: 1040px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 48px;
		}
	}

	@media (max-width: 760px) {
		.hero {
			padding-top: 16px;
		}
	}
</style>
