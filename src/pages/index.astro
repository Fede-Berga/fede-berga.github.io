---
import { getCollection } from 'astro:content';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import { experience, projects, teaching } from '../data/site';
import Base from '../layouts/Base.astro';

const publications = (await getCollection('publications'))
	.map((entry) => entry.data)
	.sort((a, b) => b.year - a.year || a.title.localeCompare(b.title));

const listItem =
	'grid gap-x-6 gap-y-1 border-t border-rule pt-5 pb-[22px] first:border-t-0 first:pt-0 sm:grid-cols-[5.5rem_1fr] sm:gap-y-0';
const when = 'pt-[0.2rem] text-sm text-muted tabular-nums';
const heading = 'max-w-[42ch] text-lg leading-[1.3] font-semibold tracking-[-0.01em]';
const prose = 'max-w-[34em] text-lg leading-normal tracking-[-0.01em] sm:text-xl';
---

<Base
	title="Federico Bergamini"
	description="Federico Bergamini, PhD student in software verification and validation at the University of Luxembourg."
>
	<Header />

	<main id="main" class="mx-auto max-w-[1160px] px-4 sm:px-6 md:px-10">
		<div class="grid gap-x-10 border-t border-ink pt-14 pb-18 md:grid-cols-[3fr_9fr] md:pt-24 md:pb-26">
			<p class="mb-6 animate-rise text-sm text-muted tabular-nums [animation-delay:60ms] md:mb-0 md:pt-[0.9rem]">
				<span class="mr-[0.55rem] inline-block size-[9px] bg-accent align-[0.05em]" aria-hidden="true"></span>Software
				verification
			</p>
			<div>
				<h1
					class="animate-rise text-[clamp(2.6rem,6.2vw,4.75rem)] leading-none font-semibold tracking-[-0.035em] [animation-delay:160ms]"
				>
					Federico Bergamini
				</h1>
				<p
					class="mt-6 max-w-[34ch] animate-rise text-[clamp(1.3rem,2.2vw,1.75rem)] leading-[1.3] tracking-[-0.015em] [animation-delay:260ms] sm:mt-8"
				>
					PhD student at the University of Luxembourg, working on metamorphic security testing. <span class="text-muted"
						>Previously a research fellow, an embedded software engineer and a computer science teacher.</span
					>
				</p>
			</div>
		</div>

		<Section n="01" id="about" title="About" class="animate-rise [animation-delay:360ms]">
			<div class="space-y-[1.1rem]">
				<p class={prose}>
					Since 2026 I have been a PhD student at SnT, the Interdisciplinary Centre for Security, Reliability and
					Trust, in the Software Verification and Validation (SVV) group. My project, MORTAL, studies metamorphic
					security testing assisted by large language models.
				</p>
				<p class:list={[prose, 'text-muted']}>
					I build backend services on the JVM, networked and low-level software in Rust, and simulations and tooling
					in Python.
				</p>
			</div>
		</Section>

		<Section n="02" id="projects" title="Selected projects">
			<ul class="grid gap-x-10 sm:grid-cols-2">
				{
					projects.map((project) => (
						<li class="border-t border-rule pt-5 pb-8 first:border-t-0 first:pt-0 sm:nth-2:border-t-0 sm:nth-2:pt-0">
							<h3 class="text-lg leading-[1.3] font-semibold tracking-[-0.01em]">
								<a class="group link-quiet" href={project.href}>
									{project.name}<span
										class="ml-[0.2em] inline-block font-normal text-muted transition-[translate,color] duration-[220ms] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
										aria-hidden="true">↗</span
									>
								</a>
							</h3>
							<p class="mt-[0.4rem] max-w-[40ch] text-muted">{project.summary}</p>
							<p class="mt-3 text-[0.8125rem]">
								{project.stack.join(' · ')}
								{project.demo && (
									<>
										{' · '}
										<a href={project.demo}>Play</a>
									</>
								)}
							</p>
						</li>
					))
				}
			</ul>
		</Section>

		<Section n="03" id="publications" title="Publications">
			<ol>
				{
					publications.map((publication) => (
						<li class={listItem}>
							<span class={when}>{publication.year}</span>
							<div>
								<h3 class={heading}>{publication.title}</h3>
								<p class="mt-[0.35rem] text-muted">
									{publication.authors.join(', ')}. <span class="text-ink">{publication.venue}</span>.
								</p>
								{publication.doi && (
									<a class="mt-2 inline-block text-sm tabular-nums" href={`https://doi.org/${publication.doi}`}>
										doi:{publication.doi}
									</a>
								)}
							</div>
						</li>
					))
				}
			</ol>
		</Section>

		<Section n="04" id="experience" title="Experience">
			<ol>
				{
					experience.map((item) => (
						<li class={listItem}>
							<span class={when}>{item.when}</span>
							<div>
								<h3 class={heading}>
									{item.role}
									{item.current && (
										<span class="ml-[0.4rem] align-[0.1em] text-xs font-medium tracking-[0.06em] text-accent uppercase">
											Now
										</span>
									)}
								</h3>
								<p class="mt-[0.35rem] text-muted">{item.detail}</p>
							</div>
						</li>
					))
				}
			</ol>
		</Section>

		<Section n="05" id="teaching" title="Teaching">
			<div>
				<p class:list={[prose, 'text-muted']}>
					Course material from teaching computer science at a technical high school.
				</p>
				<ul class="mt-5 flex flex-wrap gap-x-10 gap-y-2">
					{
						teaching.map((repo) => (
							<li>
								<a class="font-medium" href={repo.href}>
									{repo.name}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</Section>
	</main>

	<Footer />
</Base>
